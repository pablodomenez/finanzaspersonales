# ── Local (SQLite) ──────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./finanzas.db

# ── Producción (Supabase PostgreSQL) ────────────────────────────────────────────
# Obtené la URL desde: Supabase → Settings → Database → Connection string → URI
# Usá el string de "Transaction pooler" (puerto 6543) para Vercel serverless
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Clave secreta para JWT — generá una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga

# Minutos de duración del token (10080 = 7 días)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Dominio permitido para CORS (tu URL de Vercel)
# En Vercel, configurá esto como variable de entorno en el dashboard
ALLOWED_ORIGINS=https://finanzasenorden.vercel.app
